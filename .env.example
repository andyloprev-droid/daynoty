# ============ API Keys (REQUERIDO) ============
# Anthropic Claude API Key (para resúmenes)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (OPCIONAL - solo si generas imágenes con DALL-E)
# Descomenta si decides activar generación de imágenes
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# ============ Google Cloud Configuration (REQUERIDO) ============
# ID del proyecto Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id

# Ruta al archivo JSON de credenciales de Google Cloud
# Descargar desde: https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_KEY_PATH=/path/to/service-account-key.json

# ============ Google Cloud Storage (REQUERIDO) ============
# Nombre del bucket en Google Cloud Storage
CLOUD_STORAGE_BUCKET=your-bucket-name

# ============ Firestore Configuration ============
# Nombre de la base de datos Firestore (por defecto: noticias)
FIRESTORE_DATABASE=noticias

# ============ Configuración de Scraping ============
# Timeout en segundos para requests
REQUEST_TIMEOUT=10

# Máximo número de reintentos
MAX_RETRIES=3

# Delay entre reintentos (segundos)
RETRY_DELAY=2

# ============ Scheduling ============
# Intervalo de ejecución en minutos (default: 60 = cada hora)
SCHEDULER_INTERVAL_MINUTES=60

# Zona horaria (default: America/New_York para EST)
SCHEDULER_TIMEZONE=America/New_York

# ============ Logging ============
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============ Ambiente ============
# development o production
ENV=development

# Activar modo debug
DEBUG=False

# ============ Notas importantes ============
# 1. NUNCA versiones este archivo con credenciales reales
# 2. Copia este archivo como .env y llena los valores
# 3. Asegúrate de que .env esté en .gitignore
